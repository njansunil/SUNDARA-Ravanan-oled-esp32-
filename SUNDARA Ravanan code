static uint8_t base91Map[128];
static size_t textPosition = 0;
static uint32_t bitBuffer = 0;
static int bitCount = 0;
static int pendingValue = -1;
static uint8_t pendingBytes[2];
static uint8_t pendingCount = 0;
static uint8_t pendingPosition = 0;
static uint32_t compressedRead = 0;

#define TINFL_DICT_SIZE 32768

static tinfl_decompressor inflater;
static uint8_t inflateDict[TINFL_DICT_SIZE];
static uint8_t inflateInput[4096];
static uint8_t decodedPending[TINFL_DICT_SIZE];
static size_t inputPos = 0;
static size_t inputLen = 0;
static size_t dictOffset = 0;
static size_t pendingOutPos = 0;
static size_t pendingOutLen = 0;
static bool inflateFinished = false;

static bool base91NextByte(uint8_t &out) {
  while (pendingPosition >= pendingCount) {
    pendingPosition = 0;
    pendingCount = 0;

    if (pendingValue < 0) {
      if (textPosition >= sizeof(videoData) - 1) return false;
      uint8_t ch = (uint8_t)pgm_read_byte(videoData + textPosition++);
      if (ch >= 128 || base91Map[ch] == 0xFF) return false;
      pendingValue = base91Map[ch];
      continue;
    }

    if (textPosition < sizeof(videoData) - 1) {
      uint8_t ch = (uint8_t)pgm_read_byte(videoData + textPosition++);
      if (ch >= 128 || base91Map[ch] == 0xFF) return false;
      pendingValue += (int)base91Map[ch] * 91;
      bitBuffer |= ((uint32_t)pendingValue << bitCount);
      bitCount += ((pendingValue & 8191) > 88) ? 13 : 14;
      pendingValue = -1;

      while (bitCount >= 8 && pendingCount < 2) {
        pendingBytes[pendingCount++] = (uint8_t)(bitBuffer & 0xFF);
        bitBuffer >>= 8;
        bitCount -= 8;
      }
    } else {
      pendingBytes[0] = (uint8_t)((bitBuffer | ((uint32_t)pendingValue << bitCount)) & 0xFF);
      pendingCount = 1;
      pendingValue = -1;
    }
  }

  out = pendingBytes[pendingPosition++];
  compressedRead++;
  return true;
}

static void initBase91() {
  for (int i = 0; i < 128; ++i) base91Map[i] = 0xFF;
  for (int i = 0; i < 91; ++i) {
    uint8_t ch = (uint8_t)base91Alphabet[i];
    base91Map[ch] = (uint8_t)i;
  }
}

static bool fillCompressedInput() {
  inputPos = 0;
  inputLen = 0;
  uint8_t value;
  while (inputLen < sizeof(inflateInput) && compressedRead < COMPRESSED_LEN) {
    if (!base91NextByte(value)) return false;
    inflateInput[inputLen++] = value;
  }
  return inputLen > 0;
}

// Produce another block of decompressed bytes into decodedPending.
// The 32 KB circular dictionary is retained between calls for LZ history.
static bool inflateNextBlock() {
  if (inflateFinished) return false;

  if (inputPos >= inputLen) {
    if (!fillCompressedInput()) return false;
  }

  size_t inAvailable = inputLen - inputPos;
  size_t outAvailable = TINFL_DICT_SIZE - dictOffset;

  uint32_t flags = TINFL_FLAG_PARSE_ZLIB_HEADER | TINFL_FLAG_COMPUTE_ADLER32;
  if (compressedRead < COMPRESSED_LEN) flags |= TINFL_FLAG_HAS_MORE_INPUT;

  tinfl_status status = tinfl_decompress(
    &inflater,
    inflateInput + inputPos,
    &inAvailable,
    inflateDict,
    inflateDict + dictOffset,
    &outAvailable,
    flags
  );

  inputPos += inAvailable;
  pendingOutLen = outAvailable;  // tinfl returns bytes PRODUCED in this parameter
  pendingOutPos = 0;

  if (pendingOutLen > 0) {
    memcpy(decodedPending, inflateDict + dictOffset, pendingOutLen);
    dictOffset = (dictOffset + pendingOutLen) & (TINFL_DICT_SIZE - 1);
  }

  if (status == TINFL_STATUS_DONE) inflateFinished = true;
  else if (status < 0) return false;
  else if (status == TINFL_STATUS_NEEDS_MORE_INPUT && inputPos >= inputLen &&
           compressedRead >= COMPRESSED_LEN && pendingOutLen == 0) return false;

  return pendingOutLen > 0 || status == TINFL_STATUS_DONE;
}

static bool readDecodedBytes(uint8_t *dst, size_t wanted) {
  size_t copied = 0;
  while (copied < wanted) {
    if (pendingOutPos >= pendingOutLen) {
      if (!inflateNextBlock()) return false;
      if (pendingOutPos >= pendingOutLen) continue;
    }

    size_t available = pendingOutLen - pendingOutPos;
    size_t take = wanted - copied;
    if (take > available) take = available;

    memcpy(dst + copied, decodedPending + pendingOutPos, take);
    copied += take;
    pendingOutPos += take;
  }
  return true;
}

static void stopWithError(const char *message) {
  Serial.println(message);
  display.clearDisplay();
  display.setTextColor(SSD1306_WHITE);
  display.setTextSize(1);
  display.setCursor(0, 0);
  display.println("VIDEO ERROR");
  display.println(message);
  display.display();
  while (true) delay(1000);
}

void setup() {
  Serial.begin(115200);
  delay(150);

  Wire.begin(OLED_SDA, OLED_SCL);
  Wire.setClock(400000);
  if (!display.begin(SSD1306_SWITCHCAPVCC, OLED_ADDRESS)) {
    Serial.println("SSD1306 init failed. Check SDA/SCL and address.");
    while (true) delay(1000);
  }

  display.clearDisplay();
  display.display();

  initBase91();
  tinfl_init(&inflater);

  static uint8_t frameBuffer[FRAME_BYTES];
  uint32_t frameNumber = 0;
  const uint32_t frameIntervalUs = 1000000UL / VIDEO_FPS;
  uint32_t nextFrameTime = micros();

  while (frameNumber < FRAME_COUNT) {
    if (!readDecodedBytes(frameBuffer, FRAME_BYTES)) {
      stopWithError("DEFLATE decode / frame read failed");
    }

    display.clearDisplay();
    display.drawBitmap(0, 0, frameBuffer, SCREEN_WIDTH, SCREEN_HEIGHT, SSD1306_WHITE);
    display.display();

    frameNumber++;
    nextFrameTime += frameIntervalUs;
    while ((int32_t)(micros() - nextFrameTime) < 0) {
      delayMicroseconds(100);
    }
    if ((int32_t)(micros() - nextFrameTime) > (int32_t)frameIntervalUs) {
      nextFrameTime = micros();
    }

    if ((frameNumber % 30) == 0) {
      Serial.printf("Frame %lu / %u\n", (unsigned long)frameNumber, FRAME_COUNT);
    }
  }

  Serial.println("Video playback complete.");
}

void loop() {
  // One-shot playback. Press ESP32 reset to replay.
}
